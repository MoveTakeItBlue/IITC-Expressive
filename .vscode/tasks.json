{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Assemble Debug APK",
            "type": "shell",
            "command": "./gradlew",
            "args": ["assembleDebug"],
            "windows": {
                "command": ".\\gradlew.bat",
                "args": ["assembleDebug"]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$kotlinc"]
        },
        {
            "label": "Install Debug APK",
            "type": "shell",
            "command": "./gradlew",
            "args": ["installDebug"],
            "windows": {
                "command": ".\\gradlew.bat",
                "args": ["installDebug"]
            },
            "group": "build",
            "problemMatcher": ["$kotlinc"]
        },
        {
            "label": "Launch Android App",
            "type": "shell",
            "command": "adb",
            "args": [
                "shell",
                "am",
                "start",
                "-n",
                "io.github.movetakeitblue.iitcexpressive/.MainActivity"
            ],
            "dependsOn": "Install Debug APK",
            "problemMatcher": []
        },
        {
            "label": "Stop Android App",
            "type": "shell",
            "command": "adb",
            "args": [
                "shell",
                "am",
                "force-stop",
                "io.github.movetakeitblue.iitcexpressive"
            ],
            "problemMatcher": []
        }
    ]
}
